{
  "name": "Distributed Matrix Multiply GPU Worker",
  "image": "matrixcompute/worker:gpu",
  "tag": "latest",
  "env": {
    "MATRIX_WORKER_PAYOUT_ADDRESS": "",
    "MATRIX_WORKER_NOSTR_RELAYS": "wss://relay.matrixcompute.io",
    "MATRIX_WORKER_SETTLEMENT_API_URL": "http://settlement.matrixcompute.io:8000",
    "MATRIX_WORKER_NAT_MODE": "reverse_tunnel",
    "MATRIX_WORKER_SATS_PER_GFLOP": "1.0",
    "MATRIX_WORKER_MIN_TASK_SATS": "1"
  },
  "run_command": "python -m src.main",
  "extra_args": "--ipc=host --gpus all",
  "disk_space_gb": 20,
  "desc": "1-Click Community Worker template for idle GPU instances on Vast.ai to earn Lightning Network yield."
}
