# syntax=docker/dockerfile:1
# ------------------------------------------------------------------------------
# Matrix Compute Node Image (NVIDIA GPU / CUDA execution engine)
# Optimized for Vast.ai, RunPod (RTX 3090 / 4090 / A100), and local GPU hosts.
# Uses pytorch/pytorch base layer (pre-cached on Vast.ai & RunPod hosts for fast boot).
# ------------------------------------------------------------------------------

FROM pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install minimal system utilities + Tailscale (for zero-config mesh networking on cloud GPUs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    iproute2 \
    libcap2-bin \
    && curl -fsSL https://tailscale.com/install.sh | sh \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install NVML Python bindings for Tier-1 GPU hardware attestation
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir "pynvml>=11.5.0"

# Install shared contracts library and remove source afterwards
COPY matrix-contracts /tmp/matrix-contracts
RUN pip install --no-cache-dir /tmp/matrix-contracts && rm -rf /tmp/matrix-contracts

# Install compute node daemon and remove source afterwards
COPY matrix-compute-node /tmp/matrix-compute-node
RUN pip install --no-cache-dir /tmp/matrix-compute-node && rm -rf /tmp/matrix-compute-node

# Copy entrypoint script (handles optional TAILSCALE_AUTHKEY and Vast.ai/RunPod startup)
COPY matrix-dockerimages/compute-node/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh

# Expose default gRPC P2P compute port
EXPOSE 50051

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
